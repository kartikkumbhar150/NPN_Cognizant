# ── Chatbot service ──────────────────────────────────────────────────────────
# Standalone service port (documentation only — uvicorn CLI sets it):
#   uvicorn chatbot.app.main:app --host 127.0.0.1 --port 8001
# CHAT_SERVICE_PORT=8001

# ── Qdrant vector store ──────────────────────────────────────────────────────
# Empty QDRANT_URL = local embedded mode under QDRANT_LOCAL_PATH.
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=hdfc_banking_knowledge_v1
# Relative paths are anchored to the chatbot/ directory.
QDRANT_LOCAL_PATH=.qdrant

# ── Embeddings (FastEmbed, CPU ONNX) ─────────────────────────────────────────
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# ── Retrieval tuning ─────────────────────────────────────────────────────────
RAG_TOP_K=5
RAG_MAX_TOP_K=20
# Empty = no score threshold; else a cosine similarity in [-1, 1].
RAG_SCORE_THRESHOLD=

# ── Existing AI engine boundary (read-only integration) ──────────────────────
# Directory that contains the ai_engine/ package and Database_csvs/.
# Default: <repo-root>/Python — set only if the layout moves.
# AI_ENGINE_DIR=

# ── Limits ───────────────────────────────────────────────────────────────────
CHAT_MAX_MESSAGE_CHARS=2000
